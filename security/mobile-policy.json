{
  "version": 2,
  "default": "deny",
  "actions": {
    "READ_STATUS": {
      "effect": "allow",
      "max_payload_bytes": 8192
    },
    "QUEUE_EVENT": {
      "effect": "allow",
      "max_payload_bytes": 65536
    },
    "SYNC_EVENTS": {
      "effect": "allow",
      "max_payload_bytes": 8192
    },
    "DEPLOY": {
      "effect": "dual_control",
      "roles": [
        "operator",
        "reviewer"
      ],
      "max_payload_bytes": 16384,
      "requires_current_epoch": true,
      "requires_unexpired_envelopes": true
    },
    "ROLLBACK": {
      "effect": "dual_control",
      "roles": [
        "operator",
        "reviewer"
      ],
      "max_payload_bytes": 16384,
      "requires_current_epoch": true,
      "requires_unexpired_envelopes": true
    }
  }
}
