{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evez-os.ai/schemas/spacetime-lab-experiment-v1.schema.json",
  "title": "EVEZ Spacetime Lab Experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "title", "hypothesis", "model_name", "claim_classification", "epistemic_status", "assumptions", "source_urls", "predictions", "controls", "safety_limits", "created_at"],
  "properties": {
    "schema_version": {"const": "evez.spacetime-lab.experiment.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 5000},
    "model_name": {"type": "string", "minLength": 1, "maxLength": 240},
    "claim_classification": {"enum": ["established", "derived", "speculative"]},
    "epistemic_status": {"const": "PROPOSED"},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_urls": {"type": "array", "items": {"type": "string", "pattern": "^(https?://|doi:)"}},
    "predictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "controls": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "safety_limits": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
