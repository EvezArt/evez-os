{
  "evex": "EVEX",
  "version": 1,
  "profile": "evez.exchange",
  "kind": "state.transition",
  "id": "example-state-transition-001",
  "transition": {
    "parent_state_hash": "sha256:replace-with-parent",
    "classification": {
      "state": "SUPPORTED",
      "basis": ["observation-001", "test-001"]
    },
    "authority": {
      "capability": "deterministic.classify",
      "policy": "example-local-policy"
    },
    "action": {
      "type": "emit_receipt",
      "input_hash": "sha256:replace-with-input"
    },
    "acceptance": {
      "tests": ["verify-observation-binding", "required-fields"]
    },
    "result": {
      "status": "SUCCEEDED",
      "observations": ["observation-002"]
    },
    "new_state_hash": "sha256:replace-with-result"
  },
  "integrity": {
    "algorithm": "sha256",
    "sha256": "replace-with-canonical-sha256"
  }
}
