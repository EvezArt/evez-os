#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

CONFIG_FILE="${EVEZ_CONFIG:-$HOME/.config/evez/evez.env}"
LOG_DIR="${EVEZ_LOG_DIR:-$HOME/.local/state/evez}"
LOG_FILE="$LOG_DIR/operator.log"

mkdir -p "$LOG_DIR"

if [ -f "$CONFIG_FILE" ]; then
  . "$CONFIG_FILE"
fi

: "${EVEZ_ENDPOINT:=https://evez-os.ai}"
: "${EVEZ_GATEWAY_HEALTH_PATH:=/health}"
: "${EVEZ_PIPELINE_PATH:=/pipeline}"
: "${EVEZ_SPINE_EVENT_PATH:=/spine/event}"
: "${EVEZ_ROOT:=$HOME/evez-os}"
: "${EVEZ_DEPLOY_HOOK:=}"

log() {
  local line
  line="$(date -Iseconds) $*"
  printf '%s\n' "$line" | tee -a "$LOG_FILE"
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    log "missing dependency: $1"
    return 1
  }
}

json_or_text() {
  local data
  data="$(cat)"
  if printf '%s' "$data" | jq . >/dev/null 2>&1; then
    printf '%s' "$data" | jq .
  else
    printf '%s\n' "$data"
  fi
}

local_witness() {
  [ "$#" -eq 2 ] || {
    printf 'usage: evezctl witness TYPE JSON\n' >&2
    return 2
  }

  local event_type="$1"
  local payload="$2"
  local spine="$LOG_DIR/spine.jsonl"
  local previous_hash="GENESIS"
  local ts event_json hash

  printf '%s' "$payload" | jq -e . >/dev/null || {
    log "invalid JSON payload"
    return 2
  }

  if [ -s "$spine" ]; then
    previous_hash="$(tail -n 1 "$spine" | jq -r '.hash // "GENESIS"')"
  fi

  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  event_json="$(jq -cn     --arg ts "$ts"     --arg type "$event_type"     --arg parent_hash "$previous_hash"     --argjson payload "$payload"     '{timestamp:$ts,type:$type,parent_hash:$parent_hash,payload:$payload}')"

  hash="$(printf '%s' "$event_json" | openssl dgst -sha256 -r | awk '{print $1}')"

  jq -cn     --argjson event "$event_json"     --arg hash "$hash"     '$event + {hash:$hash}' >> "$spine"

  jq -n     --arg event_type "$event_type"     --arg timestamp "$ts"     --arg parent_hash "$previous_hash"     --arg hash "$hash"     --arg file "$spine"     '{recorded:true,event_type:$event_type,timestamp:$timestamp,parent_hash:$parent_hash,hash:$hash,file:$file}'
}

doctor() {
  local ok=1
  for c in git curl jq python; do
    if need "$c"; then
      printf 'OK   %s -> %s\n' "$c" "$(command -v "$c")"
    else
      printf 'FAIL %s\n' "$c"
      ok=0
    fi
  done

  if [ -d "$EVEZ_ROOT/.git" ]; then
    printf 'OK   git checkout -> %s\n' "$EVEZ_ROOT"
  else
    printf 'WARN git checkout missing -> %s\n' "$EVEZ_ROOT"
  fi

  case "$EVEZ_ENDPOINT" in
    http://*|https://*) printf 'OK   endpoint -> %s\n' "$EVEZ_ENDPOINT" ;;
    *) printf 'FAIL endpoint -> %s\n' "$EVEZ_ENDPOINT"; ok=0 ;;
  esac

  printf 'LOG  %s\n' "$LOG_FILE"
  return $((ok ? 0 : 1))
}

status_cmd() {
  log "status endpoint=$EVEZ_ENDPOINT"

  if curl --fail --silent --show-error --connect-timeout 5 --max-time 15       "$EVEZ_ENDPOINT$EVEZ_GATEWAY_HEALTH_PATH" | json_or_text; then
    :
  else
    log "gateway health request failed"
    return 1
  fi

  if [ -d "$EVEZ_ROOT/.git" ]; then
    git -C "$EVEZ_ROOT" status --short --branch
    git -C "$EVEZ_ROOT" rev-parse --short HEAD
  fi
}

pipeline() {
  log "pipeline request"
  curl --fail --silent --show-error     --connect-timeout 5 --max-time 120     -X POST     -H 'Accept: application/json'     -H 'Content-Type: application/json'     "$EVEZ_ENDPOINT$EVEZ_PIPELINE_PATH"     -d '{}' | json_or_text
}

spine_event() {
  [ "$#" -eq 2 ] || {
    printf 'usage: evezctl spine-event TYPE JSON\n' >&2
    return 2
  }

  local event_type="$1"
  local payload="$2"
  printf '%s' "$payload" | jq -e . >/dev/null || {
    log "invalid JSON payload"
    return 2
  }

  log "spine event type=$event_type"
  jq -cn --arg type "$event_type" --argjson payload "$payload"     '{type:$type,payload:$payload}' |
    curl --fail --silent --show-error       --connect-timeout 5 --max-time 30       -X POST       -H 'Accept: application/json'       -H 'Content-Type: application/json'       "$EVEZ_ENDPOINT$EVEZ_SPINE_EVENT_PATH"       --data-binary @- | json_or_text
}

pull_cmd() {
  [ -d "$EVEZ_ROOT/.git" ] || {
    log "checkout missing: $EVEZ_ROOT"
    return 1
  }
  log "git pull --ff-only"
  git -C "$EVEZ_ROOT" pull --ff-only
}

deploy_cmd() {
  [ -d "$EVEZ_ROOT/.git" ] || {
    log "checkout missing: $EVEZ_ROOT"
    return 1
  }

  if [ -n "$(git -C "$EVEZ_ROOT" status --porcelain)" ]; then
    log "refusing deploy: working tree is dirty"
    git -C "$EVEZ_ROOT" status --short
    return 1
  fi

  pull_cmd

  if [ -n "$EVEZ_DEPLOY_HOOK" ]; then
    log "running deploy hook"
    bash -lc "$EVEZ_DEPLOY_HOOK"
  else
    log "no deploy hook configured; checkout verified but no remote deploy was attempted"
  fi
}

logs_cmd() {
  [ -f "$LOG_FILE" ] && tail -n 200 "$LOG_FILE" || printf 'No operator log yet.\n'
}

usage() {
  cat <<'EOF'
evezctl: EVEZ-OS mobile operator

Commands:
  doctor
  status
  pipeline
  spine-event TYPE JSON
  witness TYPE JSON
  pull
  deploy
  logs
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  doctor) doctor "$@" ;;
  status) status_cmd "$@" ;;
  pipeline) pipeline "$@" ;;
  spine-event) spine_event "$@" ;;
  pull) pull_cmd "$@" ;;
  deploy) deploy_cmd "$@" ;;
  witness) local_witness "$@" ;;
  logs) logs_cmd "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
