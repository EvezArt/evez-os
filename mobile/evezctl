#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

CONFIG_FILE="${EVEZ_CONFIG:-$HOME/.config/evez/evez.env}"
LOG_DIR="${EVEZ_LOG_DIR:-$HOME/.local/state/evez}"
LOG_FILE="$LOG_DIR/operator.log"

mkdir -p "$LOG_DIR"

if [ -f "$CONFIG_FILE" ]; then
  . "$CONFIG_FILE"
fi

: "${EVEZ_ENDPOINT:=https://evez-os.ai}"
: "${EVEZ_GATEWAY_HEALTH_PATH:=/health}"
: "${EVEZ_PIPELINE_PATH:=/pipeline}"
: "${EVEZ_SPINE_EVENT_PATH:=/spine/event}"
: "${EVEZ_ROOT:=$HOME/evez-os}"
: "${EVEZ_DEPLOY_HOOK:=}"
: "${EVEZ_STATE_DIR:=$HOME/.local/state/evez}"

log() {
  local line
  line="$(date -Iseconds) $*"
  printf '%s\n' "$line" | tee -a "$LOG_FILE"
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    log "missing dependency: $1"
    return 1
  }
}

json_or_text() {
  local data
  data="$(cat)"
  if printf '%s' "$data" | jq . >/dev/null 2>&1; then
    printf '%s' "$data" | jq .
  else
    printf '%s\n' "$data"
  fi
}

state_py() {
  printf '%s/mobile/evez_state.py' "$EVEZ_ROOT"
}

guard_py() {
  printf '%s/mobile/evez_guard.py' "$EVEZ_ROOT"
}

authority_py() {
  printf '%s/mobile/evez_authority.py' "$EVEZ_ROOT"
}

identity_py() {
  printf '%s/mobile/evez_identity.py' "$EVEZ_ROOT"
}

identity_cmd() {
  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(identity_py)" show
}

identity_verify_cmd() {
  python "$(identity_py)" verify
}

self_witness_cmd() {
  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(identity_py)" self-witness
}

local_witness() {
  [ "$#" -eq 2 ] || {
    printf 'usage: evezctl witness TYPE JSON\\n' >&2
    return 2
  }
  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(state_py)" record "$1" "$2"
}

queue_event() {
  [ "$#" -eq 2 ] || {
    printf 'usage: evezctl queue TYPE JSON\\n' >&2
    return 2
  }
  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(state_py)" record "$1" "$2" --queue
}

verify_cmd() {
  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(state_py)" verify
}

outbox_cmd() {
  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(state_py)" outbox
}

sync_cmd() {
  log "sync endpoint=$EVEZ_ENDPOINT"

  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(state_py)" verify || {
    log "refusing sync: local evidence chain is not verified"
    return 1
  }

  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(state_py)" sync "$EVEZ_ENDPOINT" "$EVEZ_SPINE_EVENT_PATH"
}

security_audit_cmd() {
  python "$(guard_py)" secret-audit
}

security_manifest_cmd() {
  python "$(guard_py)" manifest
}

security_init_cmd() {
  python "$(guard_py)" init-device
}

authorize_cmd() {
  [ "$#" -eq 2 ] || {
    printf 'usage: evezctl authorize ACTION JSON
' >&2
    return 2
  }
  python "$(guard_py)" authorize "$1" "$2"
}

verify_operation_cmd() {
  [ "$#" -eq 1 ] || {
    printf 'usage: evezctl verify-operation FILE\n' >&2
    return 2
  }
  python "$(guard_py)" verify-operation "$1"
}

authority_init_cmd() {
  [ "$#" -eq 1 ] || {
    printf 'usage: evezctl authority-init ROLE\n' >&2
    return 2
  }
  python "$(authority_py)" init-role "$1"
}

authority_sign_cmd() {
  [ "$#" -ge 3 ] || {
    printf 'usage: evezctl authority-sign ROLE ACTION JSON [OPERATION_ID]\n' >&2
    return 2
  }
  local op_id
  op_id=""
  if [ "$#" -eq 4 ]; then
    op_id="$4"
  fi
  if [ -n "$op_id" ]; then
    python "$(authority_py)" sign "$1" "$2" "$3" --operation-id "$op_id"
  else
    python "$(authority_py)" sign "$1" "$2" "$3"
  fi
}

authority_quorum_cmd() {
  [ "$#" -eq 4 ] || {
    printf 'usage: evezctl authority-quorum OPERATOR_FILE REVIEWER_FILE OPERATOR_PUBLIC REVIEWER_PUBLIC\n' >&2
    return 2
  }
  python "$(authority_py)" quorum "$@"
}

authority_epoch_cmd() {
  python "$(authority_py)" advance-epoch
}

authority_break_glass_cmd() {
  [ "$#" -ge 2 ] || {
    printf 'usage: evezctl break-glass ACTION REASON [TTL_MINUTES]\n' >&2
    return 2
  }
  if [ "$#" -eq 3 ]; then
    python "$(authority_py)" break-glass "$1" "$2" --ttl-minutes "$3"
  else
    python "$(authority_py)" break-glass "$1" "$2"
  fi
}
candidate_py() {
  printf '%s/mobile/evez_candidate.py' "$EVEZ_ROOT"
}

arsenal_py() {
  printf '%s/civic/arsenal_ledger.py' "$EVEZ_ROOT"
}

fusion_py() {
  printf '%s/civic/civic_fusion.py' "$EVEZ_ROOT"
}

civic_fuse_cmd() {
  [ "$#" -ge 1 ] || {
    printf 'usage: evezctl civic-fuse NAME=REPORT.json [...] [--output FILE]\n' >&2
    return 2
  }

  local args=()
  local output=
  local item

  while [ "$#" -gt 0 ]; do
    if [ "$1" = "--output" ]; then
      shift
      [ "$#" -eq 1 ] || {
        printf 'usage: evezctl civic-fuse NAME=REPORT.json [...] [--output FILE]\n' >&2
        return 2
      }
      output="$1"
      shift
      continue
    fi
    args+=("$1")
    shift
  done

  [ "$#" -eq 0 ] || true

  if [ -n "$output" ]; then
    python "$(fusion_py)" "${args[@]}" --output "$output"
  else
    python "$(fusion_py)" "${args[@]}"
  fi
}

arsenal_analyze_cmd() {
  [ "$#" -ge 1 ] || {
    printf 'usage: evezctl arsenal-analyze INPUT [SOURCE_NAME] [SOURCE_URI] [OUTPUT]\n' >&2
    return 2
  }

  local source_name
  local source_uri
  source_name="operator-input"
  source_uri="local://operator-input"

  if [ "$#" -ge 2 ]; then source_name="$2"; fi
  if [ "$#" -ge 3 ]; then source_uri="$3"; fi

  if [ "$#" -ge 4 ]; then
    python "$(arsenal_py)" "$1" --source-name "$source_name" --source-uri "$source_uri" --output "$4"
  else
    python "$(arsenal_py)" "$1" --source-name "$source_name" --source-uri "$source_uri"
  fi
}

candidate_evaluate_cmd() {
  [ "$#" -eq 1 ] || {
    printf 'usage: evezctl candidate-evaluate CLAIMS_JSON\n' >&2
    return 2
  }
  python "$(candidate_py)" evaluate "$1"
}

candidate_promote_cmd() {
  [ "$#" -eq 4 ] || {
    printf 'usage: evezctl candidate-promote CANDIDATE_ID EVALUATION_JSON REVIEWER_OPERATION REVIEWER_PUBLIC\n' >&2
    return 2
  }
  python "$(candidate_py)" promote "$1" "$2" "$3" "$4"
}
swarm_py() {
  printf '%s/research/anomaly_swarm_lab.py' "$EVEZ_ROOT"
}

swarm_run_cmd() {
  python "$(swarm_py)" "$@"
}

evidence_capsule_py() {
  printf '%s/evidence/evidence_capsule.py' "$EVEZ_ROOT"
}

epistemic_py() {
  printf '%s/research/epistemic_evaluator.py' "$EVEZ_ROOT"
}

survival_py() {
  printf '%s/research/epistemic_survival.py' "$EVEZ_ROOT"
}

frontier_py() {
  printf '%s/mobile/evez_frontier.py' "$EVEZ_ROOT"
}

signal_py() {
  printf '%s/mobile/evez_signal.py' "$EVEZ_ROOT"
}

kernel_py() {
  printf '%s/mobile/evez_kernel.py' "$EVEZ_ROOT"
}

signal_capabilities_py() {
  printf '%s/mobile/evez_signal_capabilities.py' "$EVEZ_ROOT"
}

precision_py() {
  printf '%s/mobile/evez_precision.py' "$EVEZ_ROOT"
}

doctor() {
  local failed=0
  for dependency in python curl jq git openssl; do
    if command -v "$dependency" >/dev/null 2>&1; then
      printf 'ok dependency=%s path=%s\n' "$dependency" "$(command -v "$dependency")"
    else
      printf 'missing dependency=%s\n' "$dependency"
      failed=1
    fi
  done

  for required_file in "$(state_py)" "$(guard_py)" "$(authority_py)" "$(identity_py)" "${EVEZ_ROOT}/identity/evez.identity.json" "$(candidate_py)" "$(arsenal_py)" "$(fusion_py)" "$(swarm_py)" "$(evidence_capsule_py)" "$(epistemic_py)" "$(survival_py)" "$(frontier_py)" "$(signal_py)" "$(kernel_py)" "$(signal_capabilities_py)" "$(precision_py)"; do
    if [ -f "$required_file" ]; then
      printf 'ok file=%s\n' "$required_file"
    else
      printf 'missing file=%s\n' "$required_file"
      failed=1
    fi
  done

  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(state_py)" verify
  return "$failed"
}

capsule_build_cmd() {
  [ "$#" -ge 2 ] || {
    printf 'usage: evezctl capsule-build OUTPUT NAME=PATH [...] [--metadata JSON]\n' >&2
    return 2
  }
  local output="$1"
  shift
  local args=("$output")
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "--metadata" ]; then
      shift
      [ "$#" -gt 0 ] || {
        printf 'usage: evezctl capsule-build OUTPUT NAME=PATH [...] [--metadata JSON]\n' >&2
        return 2
      }
      args+=(--metadata "$1")
      shift
      continue
    fi
    args+=("$1")
    shift
  done
  python "$(evidence_capsule_py)" build "${args[@]}"
}

capsule_verify_cmd() {
  [ "$#" -eq 1 ] || {
    printf 'usage: evezctl capsule-verify FILE\n' >&2
    return 2
  }
  python "$(evidence_capsule_py)" verify "$1"
}

epistemic_evaluate_cmd() {
  [ "$#" -eq 1 ] || {
    printf 'usage: evezctl epistemic-evaluate PACKET.json\n' >&2
    return 2
  }
  python "$(epistemic_py)" "$1"
}

survival_run_cmd() {
  python "$(survival_py)" "$@"
}

frontier_cmd() {
  [ "$#" -ge 1 ] || {
    printf 'usage: evezctl frontier PACKET [--output FILE]\n' >&2
    return 2
  }
  python "$(frontier_py)" "$@"
}

signal_cmd() {
  [ "$#" -ge 1 ] || {
    printf 'usage: evezctl signal PACKET (--channel CHANNEL | --auto --capabilities FILE) [--deliver]\n' >&2
    return 2
  }
  python "$(signal_py)" "$@"
}

kernel_cmd() {
  [ "$#" -ge 1 ] || {
    printf 'usage: evezctl kernel INTENT --budget FILE --requests FILE [--channels FILE]\n' >&2
    return 2
  }
  python "$(kernel_py)" "$@"
}

signal_capabilities_cmd() {
  python "$(signal_capabilities_py)" "$@"
}

precision_cmd() {
  [ "$#" -ge 1 ] || {
    printf 'usage: evezctl precision (--intent TEXT | --spec FILE)\n' >&2
    return 2
  }
  python "$(precision_py)" "$@"
}

status_cmd() {
  log "status endpoint=$EVEZ_ENDPOINT"

  if curl --fail --silent --show-error --connect-timeout 5 --max-time 15       "$EVEZ_ENDPOINT$EVEZ_GATEWAY_HEALTH_PATH" | json_or_text; then
    :
  else
    log "gateway health request failed"
    return 1
  fi

  if [ -d "$EVEZ_ROOT/.git" ]; then
    git -C "$EVEZ_ROOT" status --short --branch
    git -C "$EVEZ_ROOT" rev-parse --short HEAD
  fi

  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(state_py)" verify || {
    log "local evidence verification failed"
    return 1
  }
}

pipeline() {
  log "pipeline request"
  curl --fail --silent --show-error     --connect-timeout 5 --max-time 120     -X POST     -H 'Accept: application/json'     -H 'Content-Type: application/json'     "$EVEZ_ENDPOINT$EVEZ_PIPELINE_PATH"     -d '{}' | json_or_text
}

spine_event() {
  [ "$#" -eq 2 ] || {
    printf 'usage: evezctl spine-event TYPE JSON\n' >&2
    return 2
  }

  local event_type="$1"
  local payload="$2"
  printf '%s' "$payload" | jq -e . >/dev/null || {
    log "invalid JSON payload"
    return 2
  }

  log "spine event type=$event_type"
  jq -cn --arg type "$event_type" --argjson payload "$payload"     '{type:$type,payload:$payload}' |
    curl --fail --silent --show-error       --connect-timeout 5 --max-time 30       -X POST       -H 'Accept: application/json'       -H 'Content-Type: application/json'       "$EVEZ_ENDPOINT$EVEZ_SPINE_EVENT_PATH"       --data-binary @- | json_or_text
}

pull_cmd() {
  [ -d "$EVEZ_ROOT/.git" ] || {
    log "checkout missing: $EVEZ_ROOT"
    return 1
  }
  log "git pull --ff-only"
  git -C "$EVEZ_ROOT" pull --ff-only
}

deploy_cmd() {
  [ -d "$EVEZ_ROOT/.git" ] || {
    log "checkout missing: $EVEZ_ROOT"
    return 1
  }

  EVEZ_STATE_DIR="$EVEZ_STATE_DIR" python "$(state_py)" verify || return 1

  if [ -n "$(git -C "$EVEZ_ROOT" status --porcelain)" ]; then
    log "refusing deploy: working tree is dirty"
    git -C "$EVEZ_ROOT" status --short
    return 1
  fi

  pull_cmd

  if [ -n "$EVEZ_DEPLOY_HOOK" ]; then
    log "running deploy hook"
    bash -lc "$EVEZ_DEPLOY_HOOK"
  else
    log "no deploy hook configured; checkout verified but no remote deploy was attempted"
  fi
}

logs_cmd() {
  [ -f "$LOG_FILE" ] && tail -n 200 "$LOG_FILE" || printf 'No operator log yet.\n'
}

usage() {
  cat <<'EOF'
evezctl: EVEZ-OS mobile operator

Commands:
  doctor
  identity
  identity-verify
  self-witness
  status
  pipeline
  spine-event TYPE JSON
  witness TYPE JSON
  queue TYPE JSON
  verify
  outbox
  sync
  security-audit
  security-manifest
  security-init
  authorize ACTION JSON
  verify-operation FILE
  authority-init ROLE
  authority-sign ROLE ACTION JSON [OPERATION_ID]
  authority-quorum OPERATOR_FILE REVIEWER_FILE OPERATOR_PUBLIC REVIEWER_PUBLIC
  authority-epoch
  break-glass ACTION REASON [TTL_MINUTES]
  candidate-evaluate CLAIMS_JSON
  candidate-promote CANDIDATE_ID EVALUATION_JSON REVIEWER_OPERATION REVIEWER_PUBLIC
  arsenal-analyze INPUT [SOURCE_NAME] [SOURCE_URI] [OUTPUT]
  civic-fuse NAME=REPORT.json [...] [--output FILE]
  swarm-run [simulation arguments]
  capsule-build OUTPUT NAME=PATH [...] [--metadata JSON]
  capsule-verify FILE
  epistemic-evaluate PACKET.json
  survival-run [--min-score SCORE]
  frontier PACKET [--output FILE]
  signal PACKET (--channel CHANNEL | --auto --capabilities FILE) [--deliver]
  kernel INTENT --budget FILE --requests FILE [--channels FILE]
  signal-capabilities [--consent-scope SCOPE]... [--output FILE]
  precision (--intent TEXT | --spec FILE)
  pull
  deploy
  logs
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  doctor) doctor "$@" ;;
  identity) identity_cmd "$@" ;;
  identity-verify) identity_verify_cmd "$@" ;;
  self-witness) self_witness_cmd "$@" ;;
  status) status_cmd "$@" ;;
  pipeline) pipeline "$@" ;;
  spine-event) spine_event "$@" ;;
  pull) pull_cmd "$@" ;;
  deploy) deploy_cmd "$@" ;;
  witness) local_witness "$@" ;;
  queue) queue_event "$@" ;;
  verify) verify_cmd "$@" ;;
  outbox) outbox_cmd "$@" ;;
  sync) sync_cmd "$@" ;;
  security-audit) security_audit_cmd "$@" ;;
  security-manifest) security_manifest_cmd "$@" ;;
  security-init) security_init_cmd "$@" ;;
  authorize) authorize_cmd "$@" ;;
  verify-operation) verify_operation_cmd "$@" ;;
  authority-init) authority_init_cmd "$@" ;;
  authority-sign) authority_sign_cmd "$@" ;;
  authority-quorum) authority_quorum_cmd "$@" ;;
  authority-epoch) authority_epoch_cmd "$@" ;;
  break-glass) authority_break_glass_cmd "$@" ;;
  candidate-evaluate) candidate_evaluate_cmd "$@" ;;
  candidate-promote) candidate_promote_cmd "$@" ;;
  arsenal-analyze) arsenal_analyze_cmd "$@" ;;
  civic-fuse) civic_fuse_cmd "$@" ;;
  swarm-run) swarm_run_cmd "$@" ;;
  capsule-build) capsule_build_cmd "$@" ;;
  capsule-verify) capsule_verify_cmd "$@" ;;
  epistemic-evaluate) epistemic_evaluate_cmd "$@" ;;
  survival-run) survival_run_cmd "$@" ;;
  frontier) frontier_cmd "$@" ;;
  signal) signal_cmd "$@" ;;
  kernel) kernel_cmd "$@" ;;
  signal-capabilities) signal_capabilities_cmd "$@" ;;
  precision) precision_cmd "$@" ;;
  logs) logs_cmd "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
